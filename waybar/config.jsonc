{
  "layer": "top",
  "position": "top",
  "height": 46,
  "spacing": 0,
  "margin-top": 8,
  "margin-left": 12,
  "margin-right": 12,
  "modules-left": ["custom/launcher", "hyprland/workspaces", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right": ["cpu", "memory", "pulseaudio", "network", "tray"],

  "custom/launcher": {
    "format": "󰣇",
    "tooltip": false,
    "on-click": "walker"
  },

  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "1": "一", "2": "二", "3": "三", "4": "四",
      "5": "五", "6": "六", "7": "七", "8": "八",
      "9": "九", "10": "十", "default": "·"
    },
    "on-click": "activate",
    "sort-by-number": true,
    "all-outputs": true,
    "disable-scroll": true
  },

  "hyprland/window": {
    "format": "󰣆  {}",
    "max-length": 28,
    "separate-outputs": true,
    "rewrite": { "": "Desktop" }
  },

  "clock": {
    "format": "󰥔  {:%H:%M}",
    "tooltip-format": "󰃭  {:%A, %d %B %Y}",
    "interval": 1
  },

  "cpu": {
    "format": "󰍛  {usage}%",
    "interval": 2,
    "tooltip": true,
    "states": { "warning": 70, "critical": 90 }
  },

  "memory": {
    "format": "󰘚  {}%",
    "interval": 3,
    "tooltip-format": "RAM: {}%",
    "states": { "warning": 75, "critical": 90 }
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 muted",
    "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
    "scroll-step": 5,
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "tooltip-format": "{desc}"
  },

  "network": {
    "format-wifi": "󰤨  {signalStrength}%",
    "format-ethernet": "󰈀  LAN",
    "format-disconnected": "󰤭  Offline",
    "tooltip": true,
    "tooltip-format-wifi": "{essid}\nSignal: {signalStrength}%",
    "tooltip-format-ethernet": "Ethernet connected"
  },

  "tray": {
    "spacing": 8,
    "icon-size": 16
  }
}
